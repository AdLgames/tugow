[configuration]
entry_symbol = "modal_library_init"
compatibility_minimum = "4.3"

[libraries]
linux.debug.x86_64 =     "res://addons/modal/bin/libmodal.linux.template_debug.x86_64.so"
linux.release.x86_64 =   "res://addons/modal/bin/libmodal.linux.template_release.x86_64.so"
windows.debug.x86_64 =   "res://addons/modal/bin/libmodal.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/modal/bin/libmodal.windows.template_release.x86_64.dll"
macos.debug =            "res://addons/modal/bin/libmodal.macos.template_debug.framework"
macos.release =          "res://addons/modal/bin/libmodal.macos.template_release.framework"
android.debug.arm64 =    "res://addons/modal/bin/libmodal.android.template_debug.arm64.so"
android.release.arm64 =  "res://addons/modal/bin/libmodal.android.template_release.arm64.so"
